# ==============================================================================
# MAGIC DIARY – ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
#
# IMPORTANT:
# - Copy this file to .env or .env.local for local development.
# - NEVER commit .env, .env.local, or actual secret credentials to Git!
# - In CI/CD pipelines (GitHub Actions), inject these values via Encrypted Secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CORE CONFIGURATION (Client Identifiers)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com

# Web Client Credentials
FIREBASE_WEB_API_KEY=AIzaSyPlaceholderWebApiKeyHere000000
FIREBASE_WEB_APP_ID=1:000000000000:web:0000000000000000000000

# Android Client Credentials
FIREBASE_ANDROID_API_KEY=AIzaSyPlaceholderAndroidApiKeyHere0000
FIREBASE_ANDROID_APP_ID=1:000000000000:android:0000000000000000000000

# iOS Client Credentials
FIREBASE_IOS_API_KEY=AIzaSyPlaceholderIosApiKeyHere0000000
FIREBASE_IOS_APP_ID=1:000000000000:ios:0000000000000000000000
FIREBASE_IOS_BUNDLE_ID=in.mahato.magicdiary

# ------------------------------------------------------------------------------
# 2. FIREBASE APP CHECK CONFIGURATION
# ------------------------------------------------------------------------------
# Web reCAPTCHA v3 / Enterprise Site Key (Public client key)
FIREBASE_APPCHECK_WEB_RECAPTCHA_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
# Note: For Android & iOS in Debug mode, the debug token is logged in console.
# Register it in Firebase Console > App Check > Apps > Manage debug tokens.

# ------------------------------------------------------------------------------
# 3. FIREBASE ADMIN SDK & BACKEND WORKER (Privileged Backend Only)
#
# CAUTION: The Service Account key grants full administrative bypass.
# NEVER include this in Flutter mobile apps or public repositories.
# In GitHub Actions, store as ${{ secrets.FIREBASE_SERVICE_ACCOUNT }}.
# ------------------------------------------------------------------------------
# Either a raw JSON string or a local file path (e.g., ./service-account.json)
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"your-firebase-project-id","private_key_id":"placeholder","private_key":"-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC0placeholder\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxx@your-firebase-project-id.iam.gserviceaccount.com","client_id":"000000000000000000000"}

# Worker Runtime Parameters
LOOKAHEAD_MINUTES=30
BATCH_SIZE=100
MAX_RETRIES=3
CLAIM_LEASE_SECONDS=300
DRY_RUN=false
DEFAULT_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 4. GOOGLE ADMOB CONFIGURATION (Advertising Unit IDs)
# ------------------------------------------------------------------------------
# Android Production IDs
ADMOB_ANDROID_APP_ID=ca-app-pub-0000000000000000~0000000000
ADMOB_ANDROID_BANNER_UNIT_ID=ca-app-pub-0000000000000000/0000000000
ADMOB_ANDROID_INTERSTITIAL_UNIT_ID=ca-app-pub-0000000000000000/0000000000
ADMOB_ANDROID_REWARDED_UNIT_ID=ca-app-pub-0000000000000000/0000000000
ADMOB_ANDROID_NATIVE_UNIT_ID=ca-app-pub-0000000000000000/0000000000

# iOS Production IDs
ADMOB_IOS_APP_ID=ca-app-pub-0000000000000000~0000000000
ADMOB_IOS_BANNER_UNIT_ID=ca-app-pub-0000000000000000/0000000000
ADMOB_IOS_INTERSTITIAL_UNIT_ID=ca-app-pub-0000000000000000/0000000000
ADMOB_IOS_REWARDED_UNIT_ID=ca-app-pub-0000000000000000/0000000000
ADMOB_IOS_NATIVE_UNIT_ID=ca-app-pub-0000000000000000/0000000000

# ------------------------------------------------------------------------------
# 5. RELEASE SIGNING & KEYSTORE (Build Pipeline)
# ------------------------------------------------------------------------------
KEYSTORE_PATH=/path/to/upload-keystore.jks
KEYSTORE_PASSWORD=placeholder_keystore_password
KEY_ALIAS=upload
KEY_PASSWORD=placeholder_key_password
