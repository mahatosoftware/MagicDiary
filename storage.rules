rules_version = '2';

// ===============================================================
// Magic Diary Cloud Storage Security Rules
// ===============================================================
//
// Access Patterns:
// - User assets (invoices, receipts, warranty cards, profile photos, documents, voice notes)
//   are stored under /users/{userId}/...
// - Circle shared media and attachments are stored under /circles/{circleId}/...
// - File size limit: 15MB max to prevent storage abuse and DoS.
// - Allowed MIME content types:
//   * Images: JPEG, PNG, WebP, HEIC (image/*)
//   * Documents: PDF (application/pdf)
//   * Voice Notes / Audio: MP3, M4A, AAC, WAV (audio/*)
// - Strict authentication & ownership verification.
// - Default deny on all other paths.
//
// ===============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidFileSize() {
      return request.resource.size < 15 * 1024 * 1024; // 15 MB max
    }

    function isValidContentType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('audio/.*');
    }

    function isCircleMember(circleId) {
      return isAuthenticated() && (
        firestore.get(/databases/(default)/documents/circles/$(circleId)).data.ownerId == request.auth.uid
        || request.auth.uid in firestore.get(/databases/(default)/documents/circles/$(circleId)).data.memberUids
      );
    }

    function isCircleOwner(circleId) {
      return isAuthenticated() && firestore.get(/databases/(default)/documents/circles/$(circleId)).data.ownerId == request.auth.uid;
    }

    // User-isolated directory
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidFileSize() && isValidContentType();
      allow delete: if isOwner(userId);
    }

    // Circle shared attachments directory - strictly gated to authenticated members
    match /circles/{circleId}/{allPaths=**} {
      allow read: if isCircleMember(circleId);
      allow write: if isCircleMember(circleId) && isValidFileSize() && isValidContentType();
      allow delete: if isCircleOwner(circleId);
    }

    // Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
