rules_version = '2';

// ===============================================================
// Magic Diary Cloud Storage Security Rules
// ===============================================================
//
// Access Patterns:
// - User assets (invoices, receipts, warranty cards, profile photos, documents, voice notes)
//   are stored under /users/{userId}/...
// - Diary shared attachments: /users/{userId}/diaries/{diaryId}/attachments/...
//   strictly governed by the diary share's `allowAttachments` flag in Firestore.
// - Circle shared media and attachments are stored under /circles/{circleId}/...
// - File size limit: 15MB max to prevent storage abuse and DoS.
// - Allowed MIME content types:
//   * Images: JPEG, PNG, WebP, HEIC (image/*)
//   * Documents: PDF (application/pdf)
//   * Voice Notes / Audio: MP3, M4A, AAC, WAV (audio/*)
// - Strict authentication & ownership verification.
// - Default deny on all other paths.
//
// ===============================================================

service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidFileSize() {
      return request.resource.size < 15 * 1024 * 1024; // 15 MB max
    }

    function isValidContentType() {
      return request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('audio/.*');
    }

    function isCircleMember(circleId) {
      return isAuthenticated() && (
        firestore.get(/databases/(default)/documents/circles/$(circleId)).data.ownerId == request.auth.uid
        || request.auth.uid in firestore.get(/databases/(default)/documents/circles/$(circleId)).data.memberUids
      );
    }

    function isCircleOwner(circleId) {
      return isAuthenticated() && firestore.get(/databases/(default)/documents/circles/$(circleId)).data.ownerId == request.auth.uid;
    }

    function canReadSharedDiaryAttachment(ownerId, diaryId) {
      return isAuthenticated() && (
        (
          firestore.exists(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid))
          && (!('status' in firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid)).data) || firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid)).data.status == null || firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid)).data.status == 'active')
          && (!('expiresAt' in firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid)).data) || firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid)).data.expiresAt == null || request.time < firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid)).data.expiresAt)
          && firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid)).data.allowAttachments == true
        ) || (
          request.auth.token.email != null
          && firestore.exists(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.token.email.lower()))
          && (!('status' in firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.token.email.lower())).data) || firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.token.email.lower())).data.status == null || firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.token.email.lower())).data.status == 'active')
          && (!('expiresAt' in firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.token.email.lower())).data) || firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.token.email.lower())).data.expiresAt == null || request.time < firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.token.email.lower())).data.expiresAt)
          && firestore.get(/databases/(default)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.token.email.lower())).data.allowAttachments == true
        )
      );
    }

    // Shared Diary-specific attachments directory (gated by allowAttachments flag)
    match /users/{userId}/diaries/{diaryId}/attachments/{allPaths=**} {
      allow read: if isOwner(userId) || canReadSharedDiaryAttachment(userId, diaryId);
      allow write: if isOwner(userId) && isValidFileSize() && isValidContentType();
      allow delete: if isOwner(userId);
    }

    // User-isolated directory
    match /users/{userId}/{allPaths=**} {
      allow read: if isOwner(userId);
      allow write: if isOwner(userId) && isValidFileSize() && isValidContentType();
      allow delete: if isOwner(userId);
    }

    // Circle shared attachments directory - strictly gated to authenticated members
    match /circles/{circleId}/{allPaths=**} {
      allow read: if isCircleMember(circleId);
      allow write: if isCircleMember(circleId) && isValidFileSize() && isValidContentType();
      allow delete: if isCircleOwner(circleId);
    }

    // Default deny for all other storage paths
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
