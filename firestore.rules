        && data.keys().hasOnly(['id', 'tokenHash', 'boundEmail', 'diaryId', 'diaryName', 'ownerUid', 'ownerName', 'permission', 'sharingMode', 'grantedRecordIds', 'allowAttachments', 'allowComments', 'allowExport', 'restrictedFields', 'isOneTime', 'isClaimed', 'claimedByUid', 'claimedByEmail', 'claimedByName', 'claimedAt', 'expiresAt', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() >= 1 && data.id.size() <= 100
