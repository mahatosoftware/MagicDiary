        && isValidOptionalString(data, 'completedByUid', 100)
        && data.createdByUid is string && data.createdByUid.size() <= 100
        && isTimestampOrDateString(data.createdAt);
    }

    function isValidHouseholdSettlement(data) {
      return hasRequiredFields(data, ['id', 'householdId', 'payerUid', 'payerName', 'receiverUid', 'receiverName', 'amount', 'reason', 'date', 'isSettled'])
