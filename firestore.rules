        && isValidOptionalList(data, 'memberEmails', 100)
        && (!('schemaVersion' in data) || data.schemaVersion == null || (data.schemaVersion is int && data.schemaVersion >= 0));
    }

    function isCircleMember(members, uid) {
      return (members.size() > 0 && members[0].uid == uid)
          || (members.size() > 1 && members[1].uid == uid)
          || (members.size() > 2 && members[2].uid == uid)
          || (members.size() > 3 && members[3].uid == uid)
          || (members.size() > 4 && members[4].uid == uid)
          || (members.size() > 5 && members[5].uid == uid)
          || (members.size() > 6 && members[6].uid == uid)
          || (members.size() > 7 && members[7].uid == uid)
          || (members.size() > 8 && members[8].uid == uid)
          || (members.size() > 9 && members[9].uid == uid)
          || (members.size() > 10 && members[10].uid == uid)
          || (members.size() > 11 && members[11].uid == uid)
          || (members.size() > 12 && members[12].uid == uid)
          || (members.size() > 13 && members[13].uid == uid)
          || (members.size() > 14 && members[14].uid == uid)
          || (members.size() > 15 && members[15].uid == uid)
          || (members.size() > 16 && members[16].uid == uid)
          || (members.size() > 17 && members[17].uid == uid)
          || (members.size() > 18 && members[18].uid == uid)
          || (members.size() > 19 && members[19].uid == uid);
    }

    function isCircleAdmin(members, uid) {
      return (members.size() > 0 && members[0].uid == uid && members[0].role in ['owner', 'admin'])
          || (members.size() > 1 && members[1].uid == uid && members[1].role in ['owner', 'admin'])
          || (members.size() > 2 && members[2].uid == uid && members[2].role in ['owner', 'admin'])
          || (members.size() > 3 && members[3].uid == uid && members[3].role in ['owner', 'admin'])
          || (members.size() > 4 && members[4].uid == uid && members[4].role in ['owner', 'admin'])
          || (members.size() > 5 && members[5].uid == uid && members[5].role in ['owner', 'admin'])
          || (members.size() > 6 && members[6].uid == uid && members[6].role in ['owner', 'admin'])
          || (members.size() > 7 && members[7].uid == uid && members[7].role in ['owner', 'admin'])
          || (members.size() > 8 && members[8].uid == uid && members[8].role in ['owner', 'admin'])
          || (members.size() > 9 && members[9].uid == uid && members[9].role in ['owner', 'admin'])
          || (members.size() > 10 && members[10].uid == uid && members[10].role in ['owner', 'admin'])
          || (members.size() > 11 && members[11].uid == uid && members[11].role in ['owner', 'admin'])
          || (members.size() > 12 && members[12].uid == uid && members[12].role in ['owner', 'admin'])
          || (members.size() > 13 && members[13].uid == uid && members[13].role in ['owner', 'admin'])
          || (members.size() > 14 && members[14].uid == uid && members[14].role in ['owner', 'admin'])
          || (members.size() > 15 && members[15].uid == uid && members[15].role in ['owner', 'admin'])
          || (members.size() > 16 && members[16].uid == uid && members[16].role in ['owner', 'admin'])
          || (members.size() > 17 && members[17].uid == uid && members[17].role in ['owner', 'admin'])
          || (members.size() > 18 && members[18].uid == uid && members[18].role in ['owner', 'admin'])
          || (members.size() > 19 && members[19].uid == uid && members[19].role in ['owner', 'admin']);
    }

    function circleDocExists(circleId) {
      return exists(/databases/$(database)/documents/circles/$(circleId));
    }

    function getCircleDoc(circleId) {
      return get(/databases/$(database)/documents/circles/$(circleId));
    }

    function isCircleOwnerOrMember(circleId, uid) {
      let circle = get(/databases/$(database)/documents/circles/$(circleId));
      return circle != null && (
        circle.data.ownerId == uid
        || (circle.data.memberUids is list && uid in circle.data.memberUids)
        || (request.auth.token.email != null && circle.data.memberEmails is list && request.auth.token.email.lower() in circle.data.memberEmails)
        || isCircleMember(circle.data.members, uid)
      );
    }

    function isCircleAdminOrOwner(circleId, uid) {
      return circleDocExists(circleId) && (
        getCircleDoc(circleId).data.ownerId == uid
        || isCircleAdmin(getCircleDoc(circleId).data.members, uid)
      );
    }

    function isCircleOwnerOrAdmin(circleId, uid) {
      return isCircleAdminOrOwner(circleId, uid);
    }

    function isValidCircleInvitation(data) {
      return hasRequiredFields(data, ['id', 'circleId', 'circleName', 'inviterUid', 'inviterName', 'inviteeEmail', 'role', 'status', 'createdAt', 'expiresAt'])
