        && data.circleId is string && data.circleId.size() >= 1 && data.circleId.size() <= 100
        && data.circleName is string && data.circleName.size() >= 1 && data.circleName.size() <= 150
        && data.inviterUid is string && data.inviterUid.size() >= 1 && data.inviterUid.size() <= 100
        && data.inviterName is string && data.inviterName.size() >= 1 && data.inviterName.size() <= 100
        && data.inviteeEmail is string && data.inviteeEmail.size() <= 255 && (data.inviteeEmail == 'link' || data.inviteeEmail.size() == 0 || isValidEmail(data.inviteeEmail))
        && data.role is string && data.role in ['admin', 'editor', 'contributor', 'viewer', 'member']
        && data.status in ['pending', 'accepted', 'revoked', 'expired']
        && isTimestampOrDateString(data.createdAt)
        && isTimestampOrDateString(data.expiresAt)
        && isValidOptionalBool(data, 'isLinkInvite')
        && isValidOptionalString(data, 'token', 100)
        && isValidOptionalDate(data, 'acceptedAt')
        && isValidOptionalString(data, 'acceptedByUid', 100)
        && isValidOptionalDate(data, 'revokedAt')
        && isValidOptionalString(data, 'revokedByUid', 100)
        && isValidOptionalDate(data, 'updatedAt');
    }

    function isValidCircleTask(data, circleId) {
      return hasRequiredFields(data, ['id', 'circleId', 'title', 'createdByUid', 'dueDate', 'createdAt'])
        && data.id is string && data.id.size() <= 100
        && data.circleId == circleId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.createdByUid is string && data.createdByUid.size() <= 100
        && isTimestampOrDateString(data.dueDate)
        && isTimestampOrDateString(data.createdAt)
        && isValidOptionalString(data, 'description', 2000)
        && isValidOptionalString(data, 'sourceDiaryId', 100)
        && isValidOptionalString(data, 'sourceRecordId', 100)
        && isValidOptionalString(data, 'assignedToUid', 100)
        && isValidOptionalString(data, 'assignedToName', 100)
        && (!('priority' in data) || data.priority == null || (data.priority is string && data.priority in ['high', 'medium', 'low']))
        && (!('status' in data) || data.status == null || (data.status is string && data.status in ['open', 'assigned', 'in_progress', 'completed', 'overdue', 'cancelled']))
        && isValidOptionalDate(data, 'completedAt');
    }

    function isValidCircleExpense(data, circleId) {
      return hasRequiredFields(data, ['id', 'circleId', 'title', 'amount', 'paidByUid', 'expenseDate'])
        && data.id is string && data.id.size() <= 100
