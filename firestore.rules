    function isValidCircle(data) {
      return hasRequiredFields(data, ['id', 'name', 'category', 'ownerId', 'members', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 100
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.category is string && data.category in ['family', 'household', 'travel', 'business', 'education', 'seniorCare', 'propertyManagement', 'friends', 'custom']
        && data.ownerId is string && data.ownerId.size() <= 100
        && data.members is list && data.members.size() >= 1 && data.members.size() <= 50
