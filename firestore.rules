        && data.permission in ['viewer', 'contributor', 'editor', 'admin']
        && isTimestampOrDateString(data.createdAt)
        && isTimestampOrDateString(data.updatedAt)
        && isValidOptionalString(data, 'circleId', 100)
        && isValidOptionalString(data, 'circleName', 150)
        && isValidOptionalString(data, 'sharedWithName', 100)
        && (!('shareEntireDiary' in data) || data.shareEntireDiary == null || data.shareEntireDiary is bool)
        && isValidOptionalList(data, 'grantedRecordIds', 500)
