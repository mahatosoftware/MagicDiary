        && data.sensitiveFields is map
        && isValidOptionalList(data, 'restrictedFields', 50)
        && isValidOptionalDate(data, 'updatedAt')
        && isValidOptionalDate(data, 'createdAt')
        && isValidOptionalString(data, 'id', 100);
    }

    // ===============================================================
