    function isValidHouseholdTask(data) {
      return hasRequiredFields(data, ['id', 'householdId', 'title', 'dueDate', 'priority', 'isCompleted', 'createdByUid', 'createdAt'])
        && data.id is string && data.id.size() <= 100
        && data.householdId is string && data.householdId.size() <= 100
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
