        && isValidOptionalDate(data, 'expiresAt')
        && isValidOptionalDate(data, 'updatedAt');
    }

    function hasSharedDiaryAccess(ownerId, diaryId) {
      let uidExactPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid);
      let uidLowerPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid.lower());
      let emailLower = request.auth.token.email != null ? request.auth.token.email.lower() : '';
      let emailPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + emailLower);
      let shareDoc = exists(uidExactPath) ? get(uidExactPath) : (
        exists(uidLowerPath) ? get(uidLowerPath) : (
          request.auth.token.email != null && exists(emailPath) ? get(emailPath) : null
        )
      );
      return isAuthenticated()
        && shareDoc != null
        && (!('status' in shareDoc.data) || shareDoc.data.status == null || shareDoc.data.status == 'active')
        && (!('expiresAt' in shareDoc.data) || shareDoc.data.expiresAt == null || request.time < shareDoc.data.expiresAt);
    }

    function canReadSharedRecord(ownerId, diaryId, recordId, recordCreatedAt) {
      let uidExactPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid);
      let uidLowerPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid.lower());
      let emailLower = request.auth.token.email != null ? request.auth.token.email.lower() : '';
      let emailPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + emailLower);
      let shareDoc = exists(uidExactPath) ? get(uidExactPath) : (
        exists(uidLowerPath) ? get(uidLowerPath) : (
          request.auth.token.email != null && exists(emailPath) ? get(emailPath) : null
        )
      );
      return isAuthenticated()
        && shareDoc != null
        && (!('status' in shareDoc.data) || shareDoc.data.status == null || shareDoc.data.status == 'active')
        && (!('expiresAt' in shareDoc.data) || shareDoc.data.expiresAt == null || request.time < shareDoc.data.expiresAt)
        && (
          (
            (shareDoc.data.shareEntireDiary == true || (!('sharingMode' in shareDoc.data) || shareDoc.data.sharingMode == 'entire'))
            && (!('shareEntireDiary' in shareDoc.data && shareDoc.data.shareEntireDiary == false))
            && (!('sharingMode' in shareDoc.data && shareDoc.data.sharingMode == 'selected'))
          )
            ? (
                !('futureRecordPolicy' in shareDoc.data)
                || shareDoc.data.futureRecordPolicy != 'existingOnly'
                || (!('snapshotCutoffTime' in shareDoc.data) || shareDoc.data.snapshotCutoffTime == null ? (!('createdAt' in shareDoc.data) || recordCreatedAt <= shareDoc.data.createdAt) : recordCreatedAt <= shareDoc.data.snapshotCutoffTime)
              )
            : (
                shareDoc.data.grantedRecordIds is list
                && recordId in shareDoc.data.grantedRecordIds
              )
        );
    }

    function hasSharedDiaryWriteAccess(ownerId, diaryId) {
      let uidExactPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid);
      let uidLowerPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid.lower());
      let emailLower = request.auth.token.email != null ? request.auth.token.email.lower() : '';
      let emailPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + emailLower);
      let shareDoc = exists(uidExactPath) ? get(uidExactPath) : (
        exists(uidLowerPath) ? get(uidLowerPath) : (
          request.auth.token.email != null && exists(emailPath) ? get(emailPath) : null
        )
      );
      return isAuthenticated()
        && shareDoc != null
        && (!('status' in shareDoc.data) || shareDoc.data.status == null || shareDoc.data.status == 'active')
        && (!('expiresAt' in shareDoc.data) || shareDoc.data.expiresAt == null || request.time < shareDoc.data.expiresAt)
        && shareDoc.data.permission in ['contributor', 'editor', 'admin'];
    }

    function canReadRecordPrivateData(ownerId, diaryId, recordId) {
      let uidExactPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid);
      let uidLowerPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid.lower());
      let emailLower = request.auth.token.email != null ? request.auth.token.email.lower() : '';
      let emailPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + emailLower);
      let shareDoc = exists(uidExactPath) ? get(uidExactPath) : (
        exists(uidLowerPath) ? get(uidLowerPath) : (
          request.auth.token.email != null && exists(emailPath) ? get(emailPath) : null
        )
      );
      return isAuthenticated()
        && shareDoc != null
        && (!('status' in shareDoc.data) || shareDoc.data.status == null || shareDoc.data.status == 'active')
        && (!('expiresAt' in shareDoc.data) || shareDoc.data.expiresAt == null || request.time < shareDoc.data.expiresAt)
        && (
          (
            (shareDoc.data.shareEntireDiary == true || (!('sharingMode' in shareDoc.data) || shareDoc.data.sharingMode == 'entire'))
            && (!('shareEntireDiary' in shareDoc.data && shareDoc.data.shareEntireDiary == false))
            && (!('sharingMode' in shareDoc.data && shareDoc.data.sharingMode == 'selected'))
          )
          || (
            shareDoc.data.grantedRecordIds is list
            && recordId in shareDoc.data.grantedRecordIds
          )
        )
        && (!('restrictedFields' in shareDoc.data) || shareDoc.data.restrictedFields == null || shareDoc.data.restrictedFields.size() == 0);
    }

    function canReadSharedAttachmentDocument(ownerId, diaryId) {
      let uidExactPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid);
      let uidLowerPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + request.auth.uid.lower());
      let emailLower = request.auth.token.email != null ? request.auth.token.email.lower() : '';
      let emailPath = /databases/$(database)/documents/shared_diary_access/$(ownerId + '_' + diaryId + '_' + emailLower);
      let shareDoc = exists(uidExactPath) ? get(uidExactPath) : (
        exists(uidLowerPath) ? get(uidLowerPath) : (
          request.auth.token.email != null && exists(emailPath) ? get(emailPath) : null
        )
      );
      return isAuthenticated()
        && shareDoc != null
        && (!('status' in shareDoc.data) || shareDoc.data.status == null || shareDoc.data.status == 'active')
        && (!('expiresAt' in shareDoc.data) || shareDoc.data.expiresAt == null || request.time < shareDoc.data.expiresAt)
        && ('allowAttachments' in shareDoc.data && shareDoc.data.allowAttachments == true);
    }

    // ===============================================================
    // Root User Profile Rule
    // ===============================================================

    match /users/{userId} {
      allow get: if isAuthenticated();
      allow list: if isOwner(userId) || (isAuthenticated() && request.query.limit <= 5);
      allow create: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow update: if isOwner(userId)
                    && isValidUserProfile(request.resource.data)
                    && areImmutableFieldsUnchanged(['createdAt', 'email']);
      allow delete: if isOwner(userId);

      // -------------------------------------------------------------
      // Subcollections (Strict User Ownership & Validator Pattern)
      // -------------------------------------------------------------

      match /products/{productId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProduct(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidProduct(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['userId', 'createdAt']);

        match /serviceRecords/{recordId} {
          allow read, delete: if isOwner(userId);
          allow create: if isOwner(userId) && isValidProductServiceRecord(request.resource.data);
          allow update: if isOwner(userId)
                        && isValidProductServiceRecord(request.resource.data)
                        && areImmutableFieldsUnchanged(['productId', 'createdAt']);
        }
      }

      match /children/{childId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidChild(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidChild(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['userId', 'createdAt']);
      }

      match /schools/{schoolId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSchool(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidSchool(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['userId', 'createdAt']);
      }

      match /academicYears/{yearId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAcademicYear(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidAcademicYear(request.resource.data)
                      && areImmutableFieldsUnchanged(['childId', 'schoolId', 'createdAt']);
      }

      match /feeStructures/{structureId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFeeStructure(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidFeeStructure(request.resource.data)
                      && areImmutableFieldsUnchanged(['academicYearId', 'createdAt']);
      }

      match /feeInstallments/{installmentId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFeeInstallment(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidFeeInstallment(request.resource.data)
                      && areImmutableFieldsUnchanged(['feeStructureId', 'childId', 'installmentNumber']);
      }

      match /feePayments/{paymentId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFeePayment(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidFeePayment(request.resource.data)
                      && areImmutableFieldsUnchanged(['installmentId', 'paymentDate']);
      }

      match /billAccounts/{accountId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBillAccount(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidBillAccount(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['userId', 'createdAt']);
      }

      match /bills/{billId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBill(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidBill(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['userId', 'billAccountId']);
      }

      match /billPayments/{paymentId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidBillPayment(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidBillPayment(request.resource.data)
                      && areImmutableFieldsUnchanged(['billId', 'billAccountId', 'paymentDate']);
      }

      match /documents/{documentId} {
        allow read: if isOwner(userId) || (resource.data.relatedDiaryId != null && canReadSharedAttachmentDocument(userId, resource.data.relatedDiaryId));
        allow delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDocumentRecord(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidDocumentRecord(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['userId', 'createdAt']);
      }

      match /reminders/{reminderId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidReminder(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidReminder(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['userId', 'createdAt']);

        match /occurrences/{occurrenceId} {
          allow read, delete: if isOwner(userId);
          allow create, update: if isOwner(userId) && isValidReminderOccurrence(request.resource.data);
        }
      }

      match /vehicles/{vehicleId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidVehicle(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidVehicle(request.resource.data)
                      && areImmutableFieldsUnchanged(['id']);
      }

      match /serviceRecords/{serviceId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidVehicleService(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidVehicleService(request.resource.data)
                      && areImmutableFieldsUnchanged(['id', 'vehicleId']);
      }

      match /transactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTransaction(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidTransaction(request.resource.data)
                      && areImmutableFieldsUnchanged(['id']);
      }

      match /investments/{investmentId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidInvestment(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidInvestment(request.resource.data)
                      && areImmutableFieldsUnchanged(['id']);
      }

      match /householdExpenses/{expenseId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHouseholdExpense(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidHouseholdExpense(request.resource.data)
                      && areImmutableFieldsUnchanged(['id']);
      }

      match /householdBudgets/{budgetId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidHouseholdBudget(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidHouseholdBudget(request.resource.data)
                      && areImmutableFieldsUnchanged(['id']);
      }

      match /shoppingList/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidShoppingItem(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidShoppingItem(request.resource.data)
                      && areImmutableFieldsUnchanged(['id', 'createdAt']);
      }

      match /properties/{propertyId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidProperty(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidProperty(request.resource.data)
                      && areImmutableFieldsUnchanged(['id']);
      }

      match /propertyMaintenances/{maintenanceId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidPropertyMaintenance(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidPropertyMaintenance(request.resource.data)
                      && areImmutableFieldsUnchanged(['id', 'propertyId']);
      }

      match /journals/{journalId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidJournal(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidJournal(request.resource.data)
                      && areImmutableFieldsUnchanged(['id']);
      }

      match /goals/{goalId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidGoal(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidGoal(request.resource.data)
                      && areImmutableFieldsUnchanged(['id']);
      }

      match /events/{eventId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidEvent(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidEvent(request.resource.data)
                      && areImmutableFieldsUnchanged(['id']);
      }

      match /financialTransactions/{transactionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCanonicalTransaction(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidCanonicalTransaction(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['id', 'userId']);
      }

      match /financialObligations/{obligationId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCanonicalObligation(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidCanonicalObligation(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['id', 'userId']);
      }

      match /recurringSchedules/{scheduleId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCanonicalSchedule(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidCanonicalSchedule(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['id', 'userId']);
      }

      match /financialCategories/{categoryId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFinancialCategory(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidFinancialCategory(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['id']);
      }

      // --- Domestic Help & Workspace User Subcollections ---

      match /userHouseholds/{householdId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidUserHousehold(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidUserHousehold(request.resource.data)
                      && areImmutableFieldsUnchanged(['householdId']);
      }

      match /domesticWorkers/{workerId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDomesticWorker(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidDomesticWorker(request.resource.data)
                      && areImmutableFieldsUnchanged(['id']);
      }

      match /workerAttendance/{attId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidWorkerAttendance(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidWorkerAttendance(request.resource.data)
                      && areImmutableFieldsUnchanged(['id', 'workerId']);
      }

      match /salaryAdvances/{advanceId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSalaryAdvance(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidSalaryAdvance(request.resource.data)
                      && areImmutableFieldsUnchanged(['id', 'workerId']);
      }

      match /salaryAdjustments/{adjId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSalaryAdjustment(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidSalaryAdjustment(request.resource.data)
                      && areImmutableFieldsUnchanged(['id', 'workerId']);
      }

      match /salaryStatements/{statementId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSalaryStatement(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidSalaryStatement(request.resource.data)
                      && areImmutableFieldsUnchanged(['id', 'workerId']);
      }

      match /recurringServices/{serviceId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidRecurringService(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidRecurringService(request.resource.data)
                      && areImmutableFieldsUnchanged(['id']);
      }

      match /serviceEntries/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidServiceEntry(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidServiceEntry(request.resource.data)
                      && areImmutableFieldsUnchanged(['id', 'serviceId']);
      }

      match /serviceBills/{billId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidServiceBill(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidServiceBill(request.resource.data)
                      && areImmutableFieldsUnchanged(['id', 'serviceId']);
      }

      // --- Notification Framework Subcollections ---

      match /notification_preferences/{prefType} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNotificationPreference(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidNotificationPreference(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['id', 'userId']);

        match /items/{itemId} {
          allow read, delete: if isOwner(userId);
          allow create: if isOwner(userId)
                        && prefType in ['modules', 'categories']
                        && isValidNotificationPreference(request.resource.data, userId);
          allow update: if isOwner(userId)
                        && prefType in ['modules', 'categories']
                        && isValidNotificationPreference(request.resource.data, userId)
                        && areImmutableFieldsUnchanged(['id', 'userId']);
        }
      }

      match /notification_overrides/{recordId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNotificationOverride(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidNotificationOverride(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['id', 'userId']);
      }

      match /notification_schedules/{scheduleId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId)
                      && isValidNotificationSchedule(request.resource.data, userId)
                      && (!('claimedByWorker' in request.resource.data) || request.resource.data.claimedByWorker == null)
                      && (!('claimLeaseExpiresAt' in request.resource.data) || request.resource.data.claimLeaseExpiresAt == null)
                      && (!('sentAt' in request.resource.data) || request.resource.data.sentAt == null)
                      && (!('attemptCount' in request.resource.data) || request.resource.data.attemptCount == null || request.resource.data.attemptCount == 0)
                      && (!('status' in request.resource.data) || request.resource.data.status in ['scheduled', 'snoozed', 'deferred', 'cancelled', 'dismissed']);
        allow update: if isOwner(userId)
                      && isValidNotificationSchedule(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['id', 'userId', 'createdAt', 'claimedByWorker', 'claimLeaseExpiresAt', 'sentAt', 'attemptCount'])
                      && (!('status' in request.resource.data) || request.resource.data.status in ['scheduled', 'snoozed', 'deferred', 'cancelled', 'dismissed', 'completed']);
      }

      match /notification_actions/{actionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNotificationAction(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidNotificationAction(request.resource.data)
                      && areImmutableFieldsUnchanged(['id', 'performedAt']);
      }

      match /notification_history/{entryId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNotificationHistory(request.resource.data);
        allow update: if isOwner(userId)
                      && isValidNotificationHistory(request.resource.data)
                      && areImmutableFieldsUnchanged(['id', 'createdAt']);
      }

      match /devices/{deviceId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidDevice(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidDevice(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['id', 'userId', 'createdAt']);
      }

      // --- Device Sessions (SessionManagementService) ---
      match /sessions/{sessionId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSession(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidSession(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['id', 'userId', 'createdAt', 'deviceId']);
      }

      // --- Append-Only Security Audit Logs (SecurityAuditService) ---
      match /security_logs/{logId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSecurityLog(request.resource.data, userId);
        allow update, delete: if false;
      }

      // --- Security & Privacy Settings ---
      match /security_settings/{settingId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidSecuritySettings(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidSecuritySettings(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['id', 'userId']);
      }

      match /frequent_contacts/{contactId} {
        allow read, delete: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFrequentContact(request.resource.data, userId);
        allow update: if isOwner(userId)
                      && isValidFrequentContact(request.resource.data, userId)
                      && areImmutableFieldsUnchanged(['userId', 'createdAt']);
      }

      // --- Universal Life OS Subdiaries & Records ---
      match /diaries/{diaryId} {
        allow read: if isOwner(userId) || hasSharedDiaryAccess(userId, diaryId);
        allow write: if isOwner(userId);

        match /records/{recordId} {
          allow get: if isOwner(userId)
                     || (isAuthenticated() && resource.data.sharedWithUids is list && request.auth.uid in resource.data.sharedWithUids)
                     || canReadSharedRecord(userId, diaryId, recordId, resource.data.createdAt);
          allow list: if isOwner(userId)
                      || (isAuthenticated() && resource.data.sharedWithUids is list && request.auth.uid in resource.data.sharedWithUids)
                      || hasSharedDiaryAccess(userId, diaryId);
          allow create: if (isOwner(userId) || hasSharedDiaryWriteAccess(userId, diaryId))
                        && isValidDiaryRecord(request.resource.data, userId, diaryId);
          allow update: if (isOwner(userId) || hasSharedDiaryWriteAccess(userId, diaryId))
                        && isValidDiaryRecord(request.resource.data, userId, diaryId)
                        && areImmutableFieldsUnchanged(['id', 'ownerId', 'sourceDiaryId', 'createdAt']);
          allow delete: if isOwner(userId) || (
            hasSharedDiaryWriteAccess(userId, diaryId)
            && resource.data.createdBy == request.auth.uid
          );

          match /private_data/{docId} {
            allow read: if isOwner(userId) || canReadRecordPrivateData(userId, diaryId, recordId);
            allow write: if isOwner(userId) && isValidPrivateData(request.resource.data, userId, diaryId, recordId);
          }
        }
      }
    }

    // ===============================================================
    // Username Registry (Safe Lookup for Recipient Resolution & Availability)
    // ===============================================================
    match /usernames/{username} {
      // Unauthenticated single-document get allows pre-registration availability checks.
      // Authenticated list allows user account maintenance and username claim lookups.
      allow get: if true;
      allow list: if isAuthenticated();
      allow create: if isAuthenticated() && isValidUsernameMapping(username, request.resource.data);
      allow update: if isAuthenticated()
                    && resource.data.uid == request.auth.uid
                    && request.resource.data.uid == request.auth.uid
                    && isValidUsernameMapping(username, request.resource.data)
                    && areImmutableFieldsUnchanged(['uid', 'createdAt']);
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // ===============================================================
    // Shared Households Collection
    // ===============================================================
    match /households/{householdId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
        || isMemberWithUid(resource.data.members, request.auth.uid)
      );
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && isValidHousehold(request.resource.data);
      allow update: if isAuthenticated()
                    && isValidHousehold(request.resource.data)
                    && areImmutableFieldsUnchanged(['id', 'ownerId', 'createdAt'])
                    && (
                      resource.data.ownerId == request.auth.uid
                      || isMemberAdmin(resource.data.members, request.auth.uid)
                      || isSelfJoiningHousehold(resource.data, request.resource.data)
                    );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;
    }

    // ===============================================================
    // Household Invitations Collection
    // ===============================================================
    match /household_invitations/{invitationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.inviterUid
        || (request.auth.token.email != null && request.auth.token.email.lower() == resource.data.inviteeEmail.lower())
      );
      allow create: if isAuthenticated()
                    && request.resource.data.inviterUid == request.auth.uid
                    && isValidHouseholdInvitation(request.resource.data);
      allow update: if isAuthenticated()
                    && isValidHouseholdInvitation(request.resource.data)
                    && areImmutableFieldsUnchanged(['id', 'householdId', 'inviterUid', 'createdAt'])
                    && (
                      request.auth.uid == resource.data.inviterUid
                      || (request.auth.token.email != null && request.auth.token.email.lower() == resource.data.inviteeEmail.lower())
                    );
      allow delete: if isAuthenticated() && resource.data.inviterUid == request.auth.uid;
    }

    // ===============================================================
    // Household Shared Tasks Collection
    // ===============================================================
    match /household_tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && request.resource.data.createdByUid == request.auth.uid
                    && isValidHouseholdTask(request.resource.data);
      allow update: if isAuthenticated()
                    && isValidHouseholdTask(request.resource.data)
                    && areImmutableFieldsUnchanged(['id', 'householdId', 'createdByUid', 'createdAt']);
      allow delete: if isAuthenticated() && resource.data.createdByUid == request.auth.uid;
    }

    // ===============================================================
    // Household Settlements (Inter-member Reimbursements) Collection
    // ===============================================================
    match /household_settlements/{settlementId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated()
                    && (request.resource.data.payerUid == request.auth.uid || request.resource.data.receiverUid == request.auth.uid)
                    && isValidHouseholdSettlement(request.resource.data);
      allow update: if isAuthenticated()
                    && isValidHouseholdSettlement(request.resource.data)
                    && areImmutableFieldsUnchanged(['id', 'householdId', 'payerUid', 'receiverUid', 'date'])
                    && (resource.data.payerUid == request.auth.uid || resource.data.receiverUid == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.payerUid == request.auth.uid;
    }

    // ===============================================================
    // Magic Circles Collection & Subcollections
    // ===============================================================
    match /circles/{circleId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerId == request.auth.uid
        || (resource.data.memberUids is list && request.auth.uid in resource.data.memberUids)
        || (request.auth.token.email != null && resource.data.memberEmails is list && request.auth.token.email.lower() in resource.data.memberEmails)
        || isCircleMember(resource.data.members, request.auth.uid)
      );
      allow create: if isAuthenticated()
                    && request.resource.data.ownerId == request.auth.uid
                    && isValidCircle(request.resource.data);
      allow update: if isAuthenticated()
                    && isValidCircle(request.resource.data)
                    && areImmutableFieldsUnchanged(['id', 'ownerId', 'createdAt'])
                    && (
                      resource.data.ownerId == request.auth.uid
                      || isCircleAdmin(resource.data.members, request.auth.uid)
                      || (
                        request.auth.token.email != null
                        && resource.data.memberEmails is list
                        && request.auth.token.email.lower() in resource.data.memberEmails
                        && areImmutableFieldsUnchanged(['id', 'name', 'category', 'ownerId', 'createdAt', 'sharedDiaryIds', 'description', 'coverImageUrl'])
                        && request.auth.uid in request.resource.data.memberUids
                      )
                      || (
                        areImmutableFieldsUnchanged(['id', 'name', 'category', 'ownerId', 'createdAt', 'sharedDiaryIds', 'description', 'coverImageUrl'])
                        && request.auth.uid in request.resource.data.memberUids
                      )
                    );
      allow delete: if isAuthenticated() && resource.data.ownerId == request.auth.uid;

      // Circle Tasks Subcollection
      match /tasks/{taskId} {
        allow read: if isAuthenticated() && isCircleOwnerOrMember(circleId, request.auth.uid);
        allow create: if isAuthenticated()
                      && isCircleOwnerOrMember(circleId, request.auth.uid)
                      && isValidCircleTask(request.resource.data, circleId);
        allow update: if isAuthenticated()
                      && isCircleOwnerOrMember(circleId, request.auth.uid)
                      && isValidCircleTask(request.resource.data, circleId)
                      && areImmutableFieldsUnchanged(['id', 'circleId', 'createdByUid', 'createdAt']);
        allow delete: if isAuthenticated() && isCircleOwnerOrMember(circleId, request.auth.uid);
      }

      // Circle Shared Expenses Subcollection
      match /expenses/{expenseId} {
        allow read: if isAuthenticated() && isCircleOwnerOrMember(circleId, request.auth.uid);
        allow create: if isAuthenticated()
                      && isCircleOwnerOrMember(circleId, request.auth.uid)
                      && isValidCircleExpense(request.resource.data, circleId);
        allow update: if isAuthenticated()
                      && isCircleOwnerOrMember(circleId, request.auth.uid)
                      && isValidCircleExpense(request.resource.data, circleId)
                      && areImmutableFieldsUnchanged(['id', 'circleId']);
        allow delete: if isAuthenticated() && isCircleOwnerOrMember(circleId, request.auth.uid);
      }

      // Circle Members Subcollection (Decoupled Membership)
      match /members/{memberUid} {
        allow read: if isAuthenticated() && (
          request.auth.uid == memberUid
          || isCircleOwnerOrMember(circleId, request.auth.uid)
        );
        allow write: if isAuthenticated() && (
          isCircleOwnerOrAdmin(circleId, request.auth.uid)
          || (request.auth.uid == memberUid && request.resource.data.uid == memberUid)
        );
      }

      // Circle Invitations Subcollection
      match /invitations/{inviteId} {
        allow read: if isAuthenticated() && (
          isCircleOwnerOrAdmin(circleId, request.auth.uid)
          || (request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())
        );
        allow create: if isAuthenticated() && isCircleOwnerOrAdmin(circleId, request.auth.uid);
        allow update, delete: if isAuthenticated() && (
          isCircleOwnerOrAdmin(circleId, request.auth.uid)
          || (request.auth.token.email != null && resource.data.email.lower() == request.auth.token.email.lower())
        );
      }
    }

    // ===============================================================
    // Circle Invitations (Magic Circles Invitations) Collection
    // ===============================================================
    match /circle_invitations/{invitationId} {
      allow get: if isAuthenticated();
      allow list: if isAuthenticated() && (
        resource.data.inviterUid == request.auth.uid
        || (request.auth.token.email != null && resource.data.inviteeEmail.lower() == request.auth.token.email.lower())
      );
      allow create: if isAuthenticated()
                    && request.resource.data.inviterUid == request.auth.uid
                    && isCircleOwnerOrAdmin(request.resource.data.circleId, request.auth.uid)
                    && isValidCircleInvitation(request.resource.data);
      allow update: if isAuthenticated()
                    && isValidCircleInvitation(request.resource.data)
                    && (
                      (
                        resource.data.inviterUid == request.auth.uid
                        && areImmutableFieldsUnchanged(['id', 'circleId', 'inviterUid', 'inviteeEmail', 'createdAt'])
                      )
                      || (
                        request.auth.token.email != null
                        && resource.data.inviteeEmail.lower() == request.auth.token.email.lower()
                        && areImmutableFieldsUnchanged(['id', 'circleId', 'inviterUid', 'inviteeEmail', 'createdAt', 'role'])
                      )
                      || (
                        request.auth.uid != resource.data.inviterUid
                        && resource.data.status == 'pending'
                        && request.resource.data.status == 'accepted'
                        && request.resource.data.acceptedByUid == request.auth.uid
                        && (!('expiresAt' in resource.data) || resource.data.expiresAt == null || request.time < resource.data.expiresAt)
                        && areImmutableFieldsUnchanged(['id', 'circleId', 'circleName', 'inviterUid', 'inviterName', 'role', 'createdAt', 'expiresAt'])
                      )
                    );
      allow delete: if isAuthenticated() && resource.data.inviterUid == request.auth.uid;
    }

    // ===============================================================
    // Shared Diary Access (Granular Diary Sharing & Permissions)
    // ===============================================================
    match /shared_diary_access/{shareId} {
      allow read: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.sharedWithUid == request.auth.uid
        || (resource.data.sharedWithUid is string && resource.data.sharedWithUid.lower() == request.auth.uid.lower())
        || (request.auth.token.email != null && resource.data.sharedWithEmail == request.auth.token.email)
        || (request.auth.token.email != null && resource.data.sharedWithEmail == request.auth.token.email.lower())
      );
      allow create: if isAuthenticated()
                    && request.resource.data.ownerUid == request.auth.uid
                    && isValidSharedDiaryAccess(request.resource.data);
      allow update: if isAuthenticated() && (
        // Owner updating permissions/settings
        (
          resource.data.ownerUid == request.auth.uid
          && isValidSharedDiaryAccess(request.resource.data)
          && areImmutableFieldsUnchanged(['ownerUid', 'diaryId'])
        )
        ||
        // Recipient claiming pending invitation (transitioning sharedWithUid to request.auth.uid)
        (
          resource.data.ownerUid != request.auth.uid
          && (
            resource.data.sharedWithUid == request.auth.uid
            || (resource.data.sharedWithUid is string && resource.data.sharedWithUid.lower() == request.auth.uid.lower())
            || (request.auth.token.email != null && resource.data.sharedWithEmail == request.auth.token.email)
            || (request.auth.token.email != null && resource.data.sharedWithEmail == request.auth.token.email.lower())
          )
          && (request.resource.data.sharedWithUid == request.auth.uid || (request.resource.data.sharedWithUid is string && request.resource.data.sharedWithUid.lower() == request.auth.uid.lower()))
          && isValidSharedDiaryAccess(request.resource.data)
          && areImmutableFieldsUnchanged(['id', 'ownerUid', 'ownerName', 'diaryId', 'diaryName', 'permission', 'createdAt', 'sharedWithEmail', 'recipientType', 'sharingMode', 'futureRecordPolicy', 'snapshotCutoffTime', 'allowAttachments', 'allowComments', 'allowExport', 'restrictedFields', 'status', 'expiresAt', 'shareEntireDiary', 'grantedRecordIds'])
        )
      );
      allow delete: if isAuthenticated() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.sharedWithUid == request.auth.uid
        || (resource.data.sharedWithUid is string && resource.data.sharedWithUid.lower() == request.auth.uid.lower())
        || (request.auth.token.email != null && resource.data.sharedWithEmail == request.auth.token.email)
        || (request.auth.token.email != null && resource.data.sharedWithEmail == request.auth.token.email.lower())
      );
    }

    // ===============================================================
    // Share Invitations (One-Time Shared Diary Deep Link Invitations)
    // ===============================================================
    match /share_invitations/{inviteId} {
      // Any authenticated user can read details to preview an invite before claiming
      allow get: if isAuthenticated();

      // Listing invitations is restricted to the owner's own documents
      allow list: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;

      allow create: if isAuthenticated()
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.id == inviteId
                    && request.resource.data.isClaimed == false
                    && isValidShareInvitation(request.resource.data);

      allow update: if isAuthenticated() && (
        // a) Owner updating settings or expiry before claim
        (
          resource.data.ownerUid == request.auth.uid
          && resource.data.isClaimed == false
          && isValidShareInvitation(request.resource.data)
          && areImmutableFieldsUnchanged(['id', 'ownerUid', 'diaryId', 'createdAt', 'isOneTime'])
        )
        ||
        // b) Recipient claiming the one-time invite
        (
          request.auth.uid != resource.data.ownerUid
          && resource.data.isClaimed == false
          && request.resource.data.isClaimed == true
          && request.resource.data.claimedByUid == request.auth.uid
          && (!('expiresAt' in resource.data) || resource.data.expiresAt == null || request.time < resource.data.expiresAt)
          && isValidShareInvitation(request.resource.data)
          && areImmutableFieldsUnchanged(['id', 'ownerUid', 'diaryId', 'diaryName', 'permission', 'sharingMode', 'grantedRecordIds', 'isOneTime', 'createdAt', 'expiresAt'])
        )
      );

      // Only the owner can delete the invitation
      allow delete: if isAuthenticated() && resource.data.ownerUid == request.auth.uid;
    }

    // ===============================================================
    // App Configuration & Version Control (Public Read-only)
    // ===============================================================
    match /app_config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // ===============================================================
    // Global Default Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
