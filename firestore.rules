        && (!('recipientType' in data) || data.recipientType == null || (data.recipientType is string && data.recipientType in ['user', 'circle']))
        && (!('sharingMode' in data) || data.sharingMode == null || (data.sharingMode is string && data.sharingMode in ['entire', 'selected']))
        && (!('futureRecordPolicy' in data) || data.futureRecordPolicy == null || (data.futureRecordPolicy is string && data.futureRecordPolicy in ['allFuture', 'existingOnly', 'askConfirm']))
        && isValidOptionalDate(data, 'snapshotCutoffTime')
