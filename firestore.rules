        && isValidOptionalNumber(data, 'amount')
        && isValidOptionalNumber(data, 'amountMinor')
        && isValidOptionalString(data, 'currency', 10)
        && (!('status' in data) || data.status == null || (data.status is string && data.status in ['active', 'completed', 'archived', 'pending']))
        && isValidOptionalList(data, 'tags', 30)
        && isValidOptionalMap(data, 'fields')
        && isValidOptionalList(data, 'restrictedFields', 50)
        && isValidOptionalBool(data, 'hasRestrictedData')
        && isValidOptionalList(data, 'restrictedFieldKeys', 50)
        && isValidOptionalList(data, 'sharedWithUids', 500)
        && isValidOptionalBool(data, 'isPrivate')
        && isValidOptionalList(data, 'attachmentIds', 50)
        && isValidOptionalString(data, 'reminderId', 100)
        && isValidOptionalString(data, 'createdBy', 100)
        && isValidOptionalString(data, 'updatedBy', 100)
        && (!('schemaVersion' in data) || data.schemaVersion == null || (data.schemaVersion is int && data.schemaVersion >= 0));
    }

    function isValidPrivateData(data, userId, diaryId, recordId) {
      return hasRequiredFields(data, ['recordId', 'ownerId', 'diaryId', 'sensitiveFields'])
        && data.recordId is string && data.recordId == recordId && data.recordId.size() <= 100
        && data.ownerId is string && data.ownerId == userId && data.ownerId.size() <= 100
