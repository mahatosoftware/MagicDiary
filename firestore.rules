    // ===============================================================
    // Universal Diary Engine Validators
    // ===============================================================

    function isValidDiaryRecord(data, userId, diaryId) {
      return hasRequiredFields(data, ['id', 'ownerId', 'sourceDiaryId', 'title', 'recordDate', 'createdAt', 'updatedAt'])
        && data.id is string && data.id.size() <= 100
        && data.ownerId == userId
        && data.sourceDiaryId == diaryId
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
