        && data.biometricEnabled is bool
        && (data.inactivityTimeoutMinutes is int || data.inactivityTimeoutMinutes is number)
        && data.inactivityTimeoutMinutes >= 0
        && data.hideSensitiveNotifications is bool
        && isTimestampOrDateString(data.updatedAt)
        && isValidOptionalDate(data, 'createdAt');
    }

    function isValidFrequentContact(data, userId) {
      return hasRequiredFields(data, ['userId', 'email', 'useCount', 'lastUsedAt', 'createdAt'])
        && data.userId == userId
        && isValidOptionalString(data, 'id', 500)
        && data.email is string && data.email.size() <= 255 && isValidEmail(data.email)
        && isValidOptionalString(data, 'name', 100)
        && isValidOptionalString(data, 'username', 50)
        && isValidOptionalString(data, 'photoUrl', 2048)
        && (data.useCount is int || data.useCount is number) && data.useCount >= 1
        && isTimestampOrDateString(data.lastUsedAt)
        && isTimestampOrDateString(data.createdAt)
        && isValidOptionalDate(data, 'updatedAt');
    }

    // ===============================================================
    // Top-Level Household Workspaces Validators & Membership Helpers
    // ===============================================================

    function isValidHouseholdMember(m) {
      return m is map
        && hasRequiredFields(m, ['uid', 'email', 'displayName', 'role'])
        && m.uid is string && m.uid.size() >= 1 && m.uid.size() <= 100
        && m.email is string && m.email.size() <= 255
        && m.displayName is string && m.displayName.size() >= 1 && m.displayName.size() <= 100
        && m.role in ['owner', 'admin', 'member', 'viewer']
        && (!('joinedAt' in m) || m.joinedAt == null || isTimestampOrDateString(m.joinedAt))
        && (!('canRecordAttendance' in m) || m.canRecordAttendance == null || m.canRecordAttendance is bool)
        && (!('canApproveSalary' in m) || m.canApproveSalary == null || m.canApproveSalary is bool)
        && (!('canViewFinancials' in m) || m.canViewFinancials == null || m.canViewFinancials is bool)
        && (!('canManageTasks' in m) || m.canManageTasks == null || m.canManageTasks is bool);
    }

    function isValidHousehold(data) {
      return hasRequiredFields(data, ['id', 'name', 'ownerId', 'members', 'createdAt'])
        && data.id is string && data.id.size() <= 100
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.ownerId is string && data.ownerId.size() <= 100
        && data.members is list && data.members.size() >= 1 && data.members.size() <= 50
        && isTimestampOrDateString(data.createdAt)
        && isValidOptionalString(data, 'timezone', 50);
    }

    function isMemberWithUid(members, uid) {
      return (members.size() > 0 && members[0].uid == uid)
          || (members.size() > 1 && members[1].uid == uid)
          || (members.size() > 2 && members[2].uid == uid)
          || (members.size() > 3 && members[3].uid == uid)
          || (members.size() > 4 && members[4].uid == uid)
          || (members.size() > 5 && members[5].uid == uid)
          || (members.size() > 6 && members[6].uid == uid)
          || (members.size() > 7 && members[7].uid == uid)
          || (members.size() > 8 && members[8].uid == uid)
          || (members.size() > 9 && members[9].uid == uid)
          || (members.size() > 10 && members[10].uid == uid)
          || (members.size() > 11 && members[11].uid == uid)
          || (members.size() > 12 && members[12].uid == uid)
          || (members.size() > 13 && members[13].uid == uid)
          || (members.size() > 14 && members[14].uid == uid);
    }

    function isMemberAdmin(members, uid) {
      return (members.size() > 0 && members[0].uid == uid && members[0].role in ['owner', 'admin'])
          || (members.size() > 1 && members[1].uid == uid && members[1].role in ['owner', 'admin'])
          || (members.size() > 2 && members[2].uid == uid && members[2].role in ['owner', 'admin'])
          || (members.size() > 3 && members[3].uid == uid && members[3].role in ['owner', 'admin'])
          || (members.size() > 4 && members[4].uid == uid && members[4].role in ['owner', 'admin'])
          || (members.size() > 5 && members[5].uid == uid && members[5].role in ['owner', 'admin'])
          || (members.size() > 6 && members[6].uid == uid && members[6].role in ['owner', 'admin'])
          || (members.size() > 7 && members[7].uid == uid && members[7].role in ['owner', 'admin'])
          || (members.size() > 8 && members[8].uid == uid && members[8].role in ['owner', 'admin'])
          || (members.size() > 9 && members[9].uid == uid && members[9].role in ['owner', 'admin'])
          || (members.size() > 10 && members[10].uid == uid && members[10].role in ['owner', 'admin'])
          || (members.size() > 11 && members[11].uid == uid && members[11].role in ['owner', 'admin'])
          || (members.size() > 12 && members[12].uid == uid && members[12].role in ['owner', 'admin'])
          || (members.size() > 13 && members[13].uid == uid && members[13].role in ['owner', 'admin'])
          || (members.size() > 14 && members[14].uid == uid && members[14].role in ['owner', 'admin']);
    }

    function isSelfJoiningHousehold(resourceData, requestData) {
      return requestData.diff(resourceData).affectedKeys().hasOnly(['members'])
        && requestData.members.size() == resourceData.members.size() + 1
        && isMemberWithUid(requestData.members, request.auth.uid);
    }

    function isValidHouseholdInvitation(data) {
      return hasRequiredFields(data, ['id', 'householdId', 'householdName', 'inviterUid', 'inviterName', 'inviteeEmail', 'role', 'token', 'status', 'expiresAt', 'createdAt'])
        && data.id is string && data.id.size() <= 100
        && data.householdId is string && data.householdId.size() <= 100
        && data.householdName is string && data.householdName.size() >= 1 && data.householdName.size() <= 150
        && data.inviterUid is string && data.inviterUid.size() <= 100
        && data.inviterName is string && data.inviterName.size() >= 1 && data.inviterName.size() <= 100
        && data.inviteeEmail is string && data.inviteeEmail.size() <= 255 && isValidEmail(data.inviteeEmail)
        && data.role in ['admin', 'member', 'viewer']
        && data.token is string && data.token.size() <= 100
        && data.status in ['pending', 'accepted', 'declined', 'expired']
        && isTimestampOrDateString(data.expiresAt)
        && isTimestampOrDateString(data.createdAt);
