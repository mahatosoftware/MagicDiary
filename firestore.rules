        && isValidOptionalMap(data, 'splitMatrix')
        && (!('isSettled' in data) || data.isSettled == null || data.isSettled is bool);
    }

    function isValidSharedDiaryAccess(data) {
      return hasRequiredFields(data, ['id', 'diaryId', 'diaryName', 'ownerUid', 'ownerName', 'sharedWithUid', 'sharedWithEmail', 'permission', 'createdAt', 'updatedAt'])
        // Deterministic share IDs include owner UID, diary ID and a recipient
        // UID/email. They can legitimately be longer than 100 characters.
        // Firestore permits document IDs up to 1,500 bytes.
        && data.id is string && data.id.size() <= 500
        && data.diaryId is string && data.diaryId.size() <= 100
        && data.diaryName is string && data.diaryName.size() >= 1 && data.diaryName.size() <= 150
        && data.ownerUid is string && data.ownerUid.size() <= 100
        && data.ownerName is string && data.ownerName.size() >= 1 && data.ownerName.size() <= 100
        && data.sharedWithUid is string && data.sharedWithUid.size() <= 255
