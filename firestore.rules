        && isValidOptionalList(data, 'restrictedFields', 50)
        && isValidOptionalString(data, 'claimedByUid', 128)
        && (!('claimedByEmail' in data) || data.claimedByEmail == null || (data.claimedByEmail is string && data.claimedByEmail.size() <= 255 && (data.claimedByEmail.size() == 0 || isValidEmail(data.claimedByEmail))))
        && isValidOptionalString(data, 'claimedByName', 100)
