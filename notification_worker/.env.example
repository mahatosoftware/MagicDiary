# Magic Diary Notification Worker Environment Configuration
FIREBASE_PROJECT_ID=magic-diary-app
# FIREBASE_SERVICE_ACCOUNT can be a raw JSON string or a file path
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"magic-diary-app",...}
# Alternatively:
# FIREBASE_SERVICE_ACCOUNT=./service-account.json

LOOKAHEAD_MINUTES=30
BATCH_SIZE=100
MAX_RETRIES=3
CLAIM_LEASE_SECONDS=300
DRY_RUN=false
DEFAULT_TIMEZONE=UTC
